STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=
STORAGE_REGION=kr-standard
STORAGE_ENDPOINT_URL=https://kr.object.ncloudstorage.com
STORAGE_ADDRESSING_STYLE=path

# readiness probe mode: config | deep
INFERENCE_STORAGE_READINESS_MODE=config

API_CAPTURE_ENABLE_MEMORY_STORE=0
API_CAPTURE_DATABASE_URL=
API_MEMORY_DEFAULT_TOP_K=5
API_MEDIA_ACCESS_URL_EXPIRES_SEC=300
API_MEDIA_GALLERY_DEFAULT_LIMIT=50

# Optional inference profile override
# INFERENCE_SERVING_PROFILE_PATH=apps/inference-server/benchmark_results/caption_serving_profile.json

HF_TOKEN=
VISION_QWEN_FALLBACK_MODEL=qwen2.5-vl-3b
VISION_QWEN_ENABLE_OBJECT_REVIEW=1

# Worker retry policy for retryable inference failures
VISION_TASK_MAX_RETRIES=2
VISION_TASK_RETRY_DELAY_SEC=10

# Optional safeguard for 7B image size issues
# VISION_QWEN_MAX_IMAGE_PIXELS=1048576
